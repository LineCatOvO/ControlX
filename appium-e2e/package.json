{
    "name": "appium-e2e",
    "version": "1.0.0",
    "description": "Appium E2E tests for WMMT Remote Controller",
    "main": "index.js",
    "scripts": {
        "test": "node tests/run-e2e-pipeline.js",
        "test:full": "node tests/run-e2e-pipeline.js",
        "test:verbose": "node tests/run-e2e-pipeline.js -v",
        "test:quick": "node tests/run-e2e-pipeline.js --skip-build",
        "test:legacy": "node tests/run-e2e.js",
        "test:input": "tsc && node dist/tests/input-e2e-test.js",
        "test:real": "node tests/real-appium-e2e.test.js",
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "appium",
        "e2e",
        "testing",
        "android",
        "remote-controller"
    ],
    "author": "WMMT Team",
    "license": "MIT",
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@types/node": "^25.2.2",
        "@types/ws": "^8.18.1",
        "appium": "^3.2.0",
        "appium-uiautomator2-driver": "^6.8.0",
        "axios": "^1.13.5",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "wd": "^1.14.0",
        "ws": "^8.19.0"
    }
}
