{
  "name": "appium-e2e",
  "version": "1.0.0",
  "description": "Appium E2E tests for WMMT Remote Controller",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:all",
    "test:all": "node tests/run-e2e-pipeline.js",
    "test:full": "node tests/run-e2e-pipeline.js",
    "test:verbose": "node tests/run-e2e-pipeline.js -v",
    "test:quick": "node tests/run-e2e-pipeline.js --skip-build",
    "test:legacy": "node tests/run-e2e.js",
    "test:ci": "node tests/run-e2e-pipeline.js --ci",
    "lint": "eslint tests/**/*.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "appium",
    "e2e",
    "testing",
    "android",
    "remote-controller"
  ],
  "author": "WMMT Team",
  "license": "MIT",
  "devDependencies": {
    "appium": "^3.2.0",
    "appium-uiautomator2-driver": "^6.8.0",
    "eslint": "^8.57.0",
    "mocha": "^10.3.0"
  },
  "dependencies": {
    "wd": "^1.14.0",
    "ws": "^8.19.0"
  }
}
