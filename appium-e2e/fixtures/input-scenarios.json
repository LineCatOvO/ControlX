      "expected": {
        "received": true,
        "middle": true
      }
    },
    "drag": {
      "description": "拖拽操作",
      "input": [
        { "x": 0, "y": 0, "left": true },
        { "x": 100, "y": 100, "left": true },
        { "x": 200, "y": 200, "left": true },
        { "x": 200, "y": 200, "left": false }
      ],
      "expected": {
        "received": true
      }
    }
  },
  
