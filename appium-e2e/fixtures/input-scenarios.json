{
  "keyboard": {
    "single_key": {
      "description": "单键按下",
      "input": {
        "keys": ["W"]
      },
      "expected": {
        "received": true,
        "keyCount": 1
      }
    },
    "multi_key": {
      "description": "多键组合",
      "input": {
        "keys": ["W", "A", "S"]
      },
      "expected": {
        "received": true,
        "keyCount": 3
      }
    },
    "wasd": {
      "description": "WASD 方向键",
      "input": {
        "keys": ["W", "A", "S", "D"]
      },
      "expected": {
        "received": true,
        "keyCount": 4
      }
    },
    "arrow_keys": {
      "description": "方向键",
      "input": {
        "keys": ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"]
      },
      "expected": {
        "received": true,
        "keyCount": 4
      }
    },
    "rapid_fire": {
      "description": "快速连击",
      "input": {
        "key": "W",
        "count": 10,
        "interval": 50
      },
      "expected": {
        "minReceived": 8
      }
    },
    "long_press": {
      "description": "长按 2 秒",
      "input": {
        "key": "W",
        "duration": 2000
      },
      "expected": {
        "minFrames": 2
      }
    }
  },
  
  "gamepad": {
    "button_a": {
      "description": "A 按钮",
      "input": {
        "buttons": ["A"]
      },
      "expected": {
