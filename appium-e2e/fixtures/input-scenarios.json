      "expected": {
        "xinputLeftTrigger": 128,
        "xinputRightTrigger": 255
      }
    },
    "full_state": {
      "description": "完整手柄状态",
      "input": {
        "buttons": ["A", "LB"],
        "axes": {
          "leftX": 0.0,
          "leftY": 0.0,
          "rightX": 0.0,
          "rightY": 0.0
        },
        "triggers": {
          "left": 0.0,
          "right": 0.0
        }
      },
      "expected": {
        "received": true
      }
    }
  },
  
  "mouse": {
    "move": {
      "description": "鼠标移动",
      "input": {
        "x": 100,
        "y": 200
