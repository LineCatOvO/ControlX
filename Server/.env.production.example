# ControlX Server 生产环境配置模板
# 复制此文件为 .env.production 并根据实际部署环境调整配置值

# =====================
# 运行模式配置
# =====================
NODE_ENV=production
TEST_MODE=false
DRY_RUN=false
DISABLE_ACTUAL_INPUT=false

# =====================
# 服务端口配置
# =====================
# WebSocket 服务端口
WS_PORT=3000

# Web 监控服务端口
WEB_PORT=8080

# =====================
# 输入配置
# =====================
# 输入更新间隔 (毫秒)
INPUT_UPDATE_INTERVAL=8

# =====================
# 心跳与安全配置
# =====================
# 心跳间隔 (毫秒)
HEARTBEAT_INTERVAL=30000

# Ping 间隔 (毫秒)
PING_INTERVAL=10000

# 安全状态超时 (毫秒)
SAFE_STATE_TIMEOUT=5000

# =====================
# 日志配置
# =====================
# 启用日志
ENABLE_LOGGING=true

# 日志级别 (error, warn, info, debug)
LOG_LEVEL=info

# =====================
# 测试模式配置（生产环境禁用）
# =====================
IS_TEST_MODE=false