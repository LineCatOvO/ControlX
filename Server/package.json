{
  "name": "server",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "start:prod": "NODE_ENV=production node dist/app.js",
    "dev": "tsc-watch --onSuccess \"node dist/app.js\"",
    "build": "tsc && cp -r src/web/static dist/web/static",
    "build:prod": "tsc && cp -r src/web/static dist/web/static",
    "clean": "rm -rf dist",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "jest",
    "lint": "eslint src/**/*.ts --fix",
    "script:build": "./scripts/build.sh build",
    "script:dev": "./scripts/build.sh dev",
    "script:all": "./scripts/build.sh all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "node-key-sender": "^1.0.11",
    "vigemclient": "^1.0.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.0.9",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.1.5",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  }
}
