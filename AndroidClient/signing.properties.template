# ControlX Android Signing Configuration Template
#
# This file should be copied to 'signing.properties' and configured with
# your actual signing credentials for production release builds.
#
# WARNING: DO NOT commit signing.properties with real credentials!
#          Add 'signing.properties' to .gitignore
#
# Instructions:
# 1. Generate a release keystore:
#    keytool -genkey -v -keystore release.keystore \
#        -alias release_key \
#        -keyalg RSA \
#        -keysize 2048 \
#        -validity 10000
#
# 2. Copy this file to 'signing.properties'
# 3. Fill in the values below
# 4. Ensure signing.properties is in .gitignore

# ==================== Signing Configuration ====================

# Keystore file path (relative to AndroidClient/ directory)
# Example: storeFile=app/release.keystore
storeFile=YOUR_KEYSTORE_FILE_PATH

# Keystore password
storePassword=YOUR_STORE_PASSWORD

# Key alias
keyAlias=YOUR_KEY_ALIAS

# Key password
keyPassword=YOUR_KEY_PASSWORD

# ==================== Alternative: Environment Variables ====================

# For CI/CD builds, you can use environment variables:
#   KEYSTORE_FILE
#   KEYSTORE_PASSWORD
#   KEY_ALIAS
#   KEY_PASSWORD
#
# Then create signing.properties dynamically:
#   echo "storeFile=$KEYSTORE_FILE" > signing.properties
#   echo "storePassword=$KEYSTORE_PASSWORD" >> signing.properties
#   echo "keyAlias=$KEY_ALIAS" >> signing.properties
#   echo "keyPassword=$KEY_PASSWORD" >> signing.properties
