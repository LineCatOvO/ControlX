# ControlX Android Build Container
#
# This Dockerfile creates a container for building the ControlX Android client.
# It includes JDK, Android SDK, and all necessary build tools.
#
# Usage:
#   Build image:  docker build -f Dockerfile.android -t controlx-android-builder .
#   Run build:    docker run --rm -v $(pwd):/workspace controlx-android-builder
#   Interactive:  docker run -it --rm -v $(pwd):/workspace controlx-android-builder bash
#
# Multi-arch support: linux/amd64, linux/arm64

# =============================================================================
# Base Image
# =============================================================================
FROM ubuntu:24.04 AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Set timezone
ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# =============================================================================
# Install Dependencies
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build essentials
    build-essential \
    ca-certificates \
    curl \
    wget \
    unzip \
    zip \
    git \
    # Java dependencies
    fontconfig \
    # Android tools dependencies
    libgl1-mesa-glx \
    lib32z1 \
    lib32ncurses6 \
    lib32stdc++6 \
    # Utilities
    vim \
    nano \
    jq \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# =============================================================================
# Install JDK 21 (Temurin)
# =============================================================================
ENV JAVA_VERSION=21
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN ARCH=$(dpkg --print-architecture) && \
    case ${ARCH} in \
        amd64) JDK_ARCH=x64 ;; \
        arm64) JDK_ARCH=aarch64 ;; \
        *) echo "Unsupported architecture: ${ARCH}" && exit 1 ;; \
    esac && \
    wget -q "https://github.com/adoptium/temurin${JAVA_VERSION}-binaries/releases/download/jdk-${JAVA_VERSION}%2B35/OpenJDK${JAVA_VERSION}U-jdk_${JDK_ARCH}_linux_hotspot_${JAVA_VERSION}_35.tar.gz" -O /tmp/openjdk.tar.gz && \
    mkdir -p /opt/java && \
    tar -xzf /tmp/openjdk.tar.gz -C /opt/java && \
    mv /opt/java/jdk-${JAVA_VERSION}+35 ${JAVA_HOME} && \
    rm /tmp/openjdk.tar.gz && \
    java -version

# =============================================================================
# Install Android SDK
# =============================================================================
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=${ANDROID_HOME}
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

# Android SDK versions
ENV ANDROID_API_LEVEL=34
ENV ANDROID_BUILD_TOOLS=34.0.0
ENV NDK_VERSION=26.1.10909125

# Download and install Android SDK Command Line Tools
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    cd ${ANDROID_HOME}/cmdline-tools && \
    wget -q "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" -O cmdline-tools.zip && \
    unzip -q cmdline-tools.zip && \
    rm cmdline-tools.zip && \
    mv cmdline-tools latest

# Accept licenses and install SDK components
RUN yes | sdkmanager --licenses && \
    sdkmanager --install \
        "platform-tools" \
        "platforms;android-${ANDROID_API_LEVEL}" \
        "build-tools;${ANDROID_BUILD_TOOLS}" \
        "ndk;${NDK_VERSION}" \
        "cmake;3.22.1" \
        "extras;android;m2repository" \
        "extras;google;m2repository"

# =============================================================================
# Install Gradle (optional, wrapper is preferred)
# =============================================================================
ENV GRADLE_VERSION=9.3.0
ENV GRADLE_HOME=/opt/gradle
ENV PATH="${GRADLE_HOME}/bin:${PATH}"

RUN wget -q "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -O /tmp/gradle.zip && \
    unzip -q /tmp/gradle.zip -d /opt && \
    mv /opt/gradle-${GRADLE_VERSION} ${GRADLE_HOME} && \
    rm /tmp/gradle.zip && \
    gradle --version

# =============================================================================
# Configure Build Environment
# =============================================================================
ENV GRADLE_OPTS="-Dorg.gradle.jvmargs=-Xmx4g -Dorg.gradle.daemon=false -Dorg.gradle.parallel=true"
ENV GRADLE_USER_HOME=/root/.gradle

# Create Gradle cache directory
RUN mkdir -p ${GRADLE_USER_HOME}/wrapper/dists

# =============================================================================
# Build Stage
# =============================================================================
FROM base AS builder

# Set working directory
WORKDIR /workspace

# Copy project files (for standalone build)
# In practice, you'll mount your project directory
COPY AndroidClient/ ./AndroidClient/

# Pre-download Gradle wrapper dependencies
RUN cd AndroidClient && \
    chmod +x gradlew && \
    ./gradlew --version

# Create local.properties with SDK path
RUN echo "sdk.dir=/opt/android-sdk" > AndroidClient/local.properties

# Default command: build debug APK
CMD ["./AndroidClient/scripts/build.sh", "debug"]

# =============================================================================
# Runtime Stage (smaller image for CI)
# =============================================================================
FROM base AS runtime

WORKDIR /workspace

# Configure environment
ENV GRADLE_OPTS="-Dorg.gradle.jvmargs=-Xmx4g -Dorg.gradle.daemon=false"

# Create entrypoint script
RUN cat > /entrypoint.sh << 'EOF'
#!/bin/bash
set -e

# Check if AndroidClient directory exists
if [ ! -d "AndroidClient" ]; then
    echo "Error: AndroidClient directory not found in /workspace"
    echo "Please mount your project: docker run -v \$(pwd):/workspace ..."
    exit 1
fi

# Create local.properties if it doesn't exist
if [ ! -f "AndroidClient/local.properties" ]; then
    echo "Creating local.properties with SDK path..."
    echo "sdk.dir=/opt/android-sdk" > AndroidClient/local.properties
fi

# Make gradlew executable
chmod +x AndroidClient/gradlew

# Run the specified command or default to debug build
if [ $# -eq 0 ]; then
    echo "No command specified, running debug build..."
    ./AndroidClient/scripts/build.sh debug
else
    echo "Running: ./AndroidClient/scripts/build.sh $@"
    ./AndroidClient/scripts/build.sh "$@"
fi
EOF

RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["debug"]

# =============================================================================
# Labels
# =============================================================================
LABEL maintainer="ControlX Team"
LABEL description="Android build environment for ControlX"
LABEL version="1.0"
LABEL android.api="34"
LABEL android.buildTools="34.0.0"
LABEL java.version="21"
LABEL gradle.version="9.3.0"
